      <aliases enabled='yes' />
      <column caption='Review Performance Score' datatype='integer' name='[Calculation_1540744487403520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Number Of Reviews] * [Review Scores Rating]' />
      </column>
      <column caption='Price Category' datatype='string' name='[Calculation_1540744488054785]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price] &gt;= 300 THEN &quot;Luxury&quot;&#13;&#10;ELSEIF [Price] &gt;= 150 THEN &quot;Standard&quot;&#13;&#10;ELSE &quot;Budget&quot;&#13;&#10;END' />
      </column>
      <column caption='Review Category' datatype='string' name='[Calculation_1540744488341506]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Number Of Reviews] &gt;= 100 THEN &quot;Highly Reviewed&quot;&#13;&#10;ELSE &quot;Less Reviewed&quot;&#13;&#10;END' />
      </column>
      <column caption='Host Status' datatype='string' name='[Calculation_1540744488755203]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Host Since] &lt;= TODAY() THEN &quot;Active Host&quot;&#13;&#10;ELSE &quot;New Host&quot;&#13;&#10;END' />
      </column>
      <column caption='Price Filter Category' datatype='string' name='[Calculation_1540744490033158]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price] &gt; [Parameters].[Parameter 1540744489037829]&#13;&#10;THEN &quot;Above Limit&quot;&#13;&#10;ELSE &quot;Below Limit&quot;&#13;&#10;END' />
      </column>
